{
  "name": "sitewatch-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-community/slider": "5.2.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-system-ui": "~57.0.4",
    "jpeg-js": "^0.4.4",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^onnxruntime-react-native$": "<rootDir>/tests/stubs/onnxruntime.ts"
